<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="RePlayerPlugin" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="debug">
				<Option output="..\bin\gcc-win32-debug\RePlayerPlugin" prefix_auto="1" extension_auto="1" />
				<Option working_dir="..\bin\gcc-win32" />
				<Option object_output="..\..\_obj_dump\irrOde\RePlayerPlugin\debug" />
				<Option type="3" />
				<Option compiler="gcc" />
				<Option createDefFile="1" />
				<Option createStaticLib="1" />
				<Compiler>
					<Add option="-Wall" />
					<Add option="-g" />
					<Add option="-DBUILD_DLL" />
				</Compiler>
				<Linker>
					<Add library="user32" />
					<Add library="..\..\bbsandbox\particle_clone\libAdvancedParticle.a" />
					<Add library="..\..\libs\irrlicht-1.7.1\lib\Win32-gcc\libIrrlicht.a" />
				</Linker>
			</Target>
			<Target title="release">
				<Option output="..\bin\gcc-win32\RePlayerPlugin" prefix_auto="1" extension_auto="1" />
				<Option working_dir="..\bin\gcc-win32" />
				<Option object_output="..\..\_obj_dump\irrOde\RePlayerPlugin\release" />
				<Option type="3" />
				<Option compiler="gcc" />
				<Option createDefFile="1" />
				<Option createStaticLib="1" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-Wall" />
					<Add option="-DBUILD_DLL" />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add library="user32" />
					<Add library="..\..\bbsandbox\particle_clone\libAdvancedParticle.a" />
					<Add library="..\..\libs\irrlicht-1.7.1\lib\Win32-gcc\libIrrlicht.a" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-D_DONT_INCLUDE_NODE" />
			<Add directory="..\..\libs\irrlicht-1.7.1\include" />
			<Add directory="..\include\IrrOdeRePlayerPlugin" />
			<Add directory="..\..\bbsandbox\particle_clone\project" />
		</Compiler>
		<Unit filename="..\include\IrrOdeRePlayerPlugin\IrrOdeRePlayerPlugin.h" />
		<Unit filename="..\source\IrrOdeRePlayerPlugin\IrrOdeRePlayerPlugin.cpp" />
		<Extensions>
			<code_completion />
			<debugger />
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
